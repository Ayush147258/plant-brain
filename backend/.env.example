# Anthropic API key for Claude Sonnet 4.6. Get this from Anthropic Console.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API key for Gemini 2.0 Flash. Get this from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project URL. Get this from Supabase project settings > API.
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Project API Key (anon or service_role). Get this from Supabase project settings > API.
SUPABASE_KEY=your_supabase_api_key_here

# Comma-separated list of allowed CORS origins for the frontend app.
ALLOWED_ORIGINS=http://localhost:3000,https://plantbrain.vercel.app

# Maximum allowed document size for upload in megabytes.
MAX_DOCUMENT_SIZE_MB=10

# Logging level for the application.
LOG_LEVEL=INFO
